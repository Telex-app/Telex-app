route:
  receiver: telex-operations
  group_by: [alertname, service, severity]
  group_wait: 30s
  group_interval: 5m
  repeat_interval: 4h
  routes:
    - matchers:
        - severity="critical"
      receiver: telex-on-call
      repeat_interval: 30m

receivers:
  - name: telex-operations
    webhook_configs:
      - url: https://alerts.example.com/telex/operations
        send_resolved: true
  - name: telex-on-call
    webhook_configs:
      - url: https://alerts.example.com/telex/on-call
        send_resolved: true

inhibit_rules:
  - source_matchers:
      - alertname="TelexApiDown"
    target_matchers:
      - service="telex-api"
    equal: [service]
