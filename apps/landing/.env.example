# URL of the admin dashboard app (used by header/footer links).
# Keep localhost in development. In production, set this to the admin subdomain,
# for example: https://admin.your-domain.com
VITE_ADMIN_URL=http://localhost:3001

# Telegram bot handle for the "Start on Telegram" CTA, without the leading @,
# e.g. telex_bot. Leave empty in dev to fall back to a plain t.me link. Set this
# in production to deep-link straight to the Telex bot.
VITE_TELEGRAM_BOT=

# Public repository URL for the footer "GitHub" link. Leave empty to omit the
# link entirely rather than render a dead anchor.
VITE_GITHUB_URL=
